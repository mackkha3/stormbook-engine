# Stormbook intake-api — environment template
# Copy to `.env` for local dev. Railway injects these in production.

# Server
PORT=3000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Google Maps geocoding (lib/geocode.py)
GOOGLE_MAPS_API_KEY=

# Meta Lead Ads webhook (handlers/meta.py)
# META_VERIFY_TOKEN must match the value set in Meta's webhook subscription UI.
# Use a random string ≥32 chars (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=

# Per-client config (production deployment).
# Takes precedence over data/clients.json. Recommended for Railway:
# rotate config via dashboard, no redeploy required (restart only).
# Format: same shape as data/clients.example.json, JSON-encoded one-liner.
# CLIENTS_JSON={"henderson-roofing":{"ghl_location_id":"loc_xxx","custom_field_ids":{"damage_type":"cf_xxx"},"service_area_zips":["75701"]}}

# Per-client GHL API keys
# Naming: GHL_API_KEY_<CLIENT_ID_UPPERCASED_WITH_UNDERSCORES>
# Example: client_id "henderson-roofing" → GHL_API_KEY_HENDERSON_ROOFING
GHL_API_KEY_HENDERSON_ROOFING=
