{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.13"
  },
  "steps": {
    "install": {
      "commands": [
        "pip install --no-cache-dir uv",
        "uv sync --frozen --no-dev"
      ]
    }
  },
  "deploy": {
    "startCommand": ".venv/bin/uvicorn demo_relay.main:app --host 0.0.0.0 --port $PORT"
  }
}
