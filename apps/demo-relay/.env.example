# apps/demo-relay — copy to .env for local dev. NEVER commit .env.

# --- Twilio (required) -------------------------------------------------
# Console → Account Info. The auth token is a live credential: rotate it if
# it ever lands in a screen share.
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=REDACTED_ROTATED_TWILIO_TOKEN
# The Twilio-provisioned number the demo texts FROM, E.164.
TWILIO_FROM_NUMBER=+19035550100
# Twilio webhook signature check on /twilio/inbound. Leave "on" everywhere real
# Twilio traffic can reach, including production (unset also means on).
# Set "off" only for local dev when POSTing fake inbound messages by hand.
# Every bypassed request logs a warning.
TWILIO_SIGNATURE_VERIFICATION=on

# --- HTTP --------------------------------------------------------------
# Comma-separated. Production: https://demo.stormbook.ai
CORS_ORIGINS=http://localhost:4323,http://127.0.0.1:4323

# development | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Auth --------------------------------------------------------------
# Bearer token required on POST /fire.
# Leave unset or empty in dev to disable auth.
# In production, generate a random 32+ char token:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# DEMO_ACCESS_TOKEN=REDACTED_ROTATED_DEMO_TOKEN

# --- Optional ----------------------------------------------------------
# Message 2 follow-up delay. Defaults to 600 (10 minutes). Drop to ~30
# during a rehearsal so you don't wait out the real window.
# MESSAGE_2_DELAY_SECONDS=600
