# apps/booking-engine — copy to .env for local dev. NEVER commit .env.

# Anthropic API key used to understand homeowner replies (required).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Conversation-state database. SQLite locally; a Postgres URL on Railway later.
DATABASE_URL=sqlite:///./booking_engine.db

# Seconds to wait for follow-up texts before answering a homeowner (default 8).
DEBOUNCE_SECONDS=8

# development | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Shared secret GHL sends in a header on every inbound webhook (Phase 2).
GHL_WEBHOOK_SECRET=

# GHL Private Integration token for the roof-demo client; the variable name is set by `ghl_token_env` in config/clients/roof-demo.yaml (Phase 2).
GHL_TOKEN_ROOF_DEMO=
